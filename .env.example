# Copy to .env.local (never commit real values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (server-side only; never prefix the secret key with NEXT_PUBLIC_)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Public origin of the site, used for the Paystack callback URL (production: https://shemahs.org)
SITE_URL=http://localhost:3000

# Thank-you emails (Resend, server-side only)
RESEND_API_KEY=

